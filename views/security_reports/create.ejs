<%- include('../layouts/header', { title: 'إضافة بلاغ أمني', pageTitle: 'السجلات الأساسية' }) %>

<div class="space-y-6 max-w-5xl mx-auto" dir="rtl">
    <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-2">
        <a href="/dashboard" class="hover:text-brand-600">الرئيسية</a><span>/</span>
        <a href="/system/security-reports" class="hover:text-brand-600">البلاغات الأمنية</a><span>/</span>
        <span class="text-slate-900 dark:text-white font-semibold">إضافة بلاغ جديد</span>
    </nav>

    <div class="flex justify-between items-center">
        <h1 class="font-display font-bold text-2xl text-slate-900 dark:text-white">إضافة بلاغ أمني جديد</h1>
        <a href="/system/security-reports" class="px-4 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-sm font-bold">عودة</a>
    </div>

    <form action="/system/security-reports" method="POST" class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm space-y-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5">الشخص المعني بالبلاغ</label>
                <select name="personal_data_id" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm">
                    <option value="">-- اختر الشخص أو أدخل الاسم يدوياً --</option>
                    <% for (const p of people) { %><option value="<%= p.id %>"><%= p.name %> (<%= p.military_number %>)</option><% } %>
                </select>
            </div>
            <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5">الاسم المبلغ عنه <span class="text-red-500">*</span></label>
                <input type="text" name="full_name" required class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm">
            </div>
            <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5">نوع البلاغ</label>
                <select name="report_type" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm">
                    <option value="اشتباه أمني">اشتباه أمني</option>
                    <option value="شكوى جنائية">شكوى جنائية</option>
                    <option value="بلاغ إداري">بلاغ إداري</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5">تاريخ البلاغ</label>
                <input type="date" name="report_date" value="<%= new Date().toISOString().slice(0, 10) %>" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm">
            </div>
            <div class="md:col-span-2">
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5">موضوع البلاغ <span class="text-red-500">*</span></label>
                <input type="text" name="report_topic" required class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm">
            </div>
            <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5">الجهة المبلغة</label>
                <select name="internal_entity_id" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm">
                    <% for (const e of entities) { %><option value="<%= e.id %>"><%= e.name %></option><% } %>
                </select>
            </div>
            <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5">المنطقة</label>
                <input type="text" name="area" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm">
            </div>
            <div class="md:col-span-2">
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-1.5">تفاصيل وملاحظات البلاغ</label>
                <textarea name="notes" rows="4" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm"></textarea>
            </div>
        </div>
        <div class="flex justify-end gap-3 pt-2">
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm cursor-pointer"><i class="fas fa-save ml-1"></i> حفظ البلاغ</button>
        </div>
    </form>
</div>

<%- include('../layouts/footer') %>
