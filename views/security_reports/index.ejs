<%- include('../layouts/header', { title: 'سجل البلاغات الأمنية', pageTitle: 'السجلات الأساسية' }) %>

<div class="space-y-6" dir="rtl">
    <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-2 print:hidden">
        <a href="/dashboard" class="hover:text-brand-600 transition-colors">الرئيسية</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white font-semibold">البلاغات الأمنية</span>
    </nav>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-2 print:hidden">
        <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-2xl bg-brand-50 dark:bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center font-bold shadow-sm shrink-0">
                <i class="fas fa-shield-alt text-xl"></i>
            </div>
            <div>
                <h1 class="font-display font-bold text-2xl text-slate-900 dark:text-white m-0">سجل البلاغات الأمنية</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">إدارة ومتابعة كافة البلاغات والتقارير الأمنية المسجلة في النظام.</p>
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-2.5">
            <button type="button" onclick="window.print()" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 cursor-pointer"><i class="fas fa-print text-xs"></i><span>طباعة الكشف</span></button>
            <a href="/system/security-reports/create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-brand-600 text-white rounded-xl hover:bg-brand-700 transition-all text-xs sm:text-sm font-bold shadow-sm">
                <i class="fas fa-plus"></i><span>إضافة بلاغ جديد</span>
            </a>
        </div>
    </div>

    <% if (flashSuccess) { %>
        <div class="bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 text-emerald-800 dark:text-emerald-300 px-4 py-3 rounded-2xl flex items-center justify-between shadow-sm">
            <div class="flex items-center gap-3"><i class="fas fa-check-circle text-emerald-500"></i><span class="text-sm font-bold"><%= flashSuccess %></span></div>
            <button type="button" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
        </div>
    <% } %>

    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-4 shadow-sm">
        <form method="GET" action="/system/security-reports" class="flex flex-col md:flex-row items-center gap-3">
            <div class="relative flex-1 w-full">
                <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-slate-400"><i class="fas fa-search"></i></div>
                <input type="text" name="search" value="<%= search || '' %>" placeholder="ابحث بالاسم، موضوع البلاغ، الرقم العسكري، أو رقم الهوية..."
                    class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl pr-10 pl-4 py-2.5 text-sm text-slate-900 dark:text-white outline-none">
            </div>
            <div class="flex items-center gap-2 w-full md:w-auto">
                <button type="submit" class="w-full md:w-auto px-5 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-700 dark:text-slate-200 text-sm font-bold cursor-pointer">تصفية النتائج</button>
                <% if (search) { %><a href="/system/security-reports" class="px-3 py-2.5 rounded-xl text-slate-400 hover:bg-slate-100 text-sm"><i class="fas fa-times"></i></a><% } %>
            </div>
        </form>
    </div>

    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-right">
                <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-bold">
                    <tr>
                        <th class="px-6 py-4 text-xs uppercase">#</th>
                        <th class="px-6 py-4 text-xs uppercase">الاسم المبلغ عنه</th>
                        <th class="px-6 py-4 text-xs uppercase">موضوع البلاغ</th>
                        <th class="px-6 py-4 text-xs uppercase text-center">تاريخ البلاغ</th>
                        <th class="px-6 py-4 text-xs uppercase">الجهة المبلغة</th>
                        <th class="px-6 py-4 text-xs uppercase text-center">نوع البلاغ</th>
                        <th class="px-6 py-4 text-xs uppercase text-left">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    <% if (reports.length === 0) { %>
                        <tr><td colspan="7" class="py-12 text-center text-slate-400">لا توجد بلاغات أمنية مطابقة</td></tr>
                    <% } %>
                    <% for (const report of reports) { %>
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/25 transition-colors">
                            <td class="px-6 py-4 text-slate-400 font-mono text-xs">#<%= String(report.id).padStart(4, '0') %></td>
                            <td class="px-6 py-4">
                                <a href="/system/security-reports/<%= report.id %>" class="font-bold text-slate-900 dark:text-white hover:text-brand-600"><%= report.full_name %></a>
                                <% if (report.military_number || report.id_number) { %><span class="block text-xs font-mono text-slate-400"><%= report.military_number || report.id_number %></span><% } %>
                            </td>
                            <td class="px-6 py-4 font-semibold text-slate-800 dark:text-slate-200"><%= report.report_topic || '-' %></td>
                            <td class="px-6 py-4 text-center"><span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-xs font-semibold"><%= report.report_date %></span></td>
                            <td class="px-6 py-4 text-xs text-slate-600 dark:text-slate-400 font-medium"><%= report.reporting_entity || report.internalEntity?.name || '-' %></td>
                            <td class="px-6 py-4 text-center"><%- include('../partials/security-badge', { level: 'warning', label: report.report_type || 'بلاغ' }) %></td>
                            <td class="px-6 py-4 text-left">
                                <div class="flex items-center justify-end gap-1.5">
                                    <a href="/system/security-reports/<%= report.id %>" class="p-2 rounded-2xl bg-slate-100 dark:bg-slate-800 text-brand-600 hover:bg-brand-50"><i class="fas fa-eye text-sm"></i></a>
                                    <form action="/system/security-reports/<%= report.id %>?_method=DELETE" method="POST" class="inline m-0">
                                        <button type="submit" class="p-2 rounded-2xl bg-red-50 text-red-600 hover:bg-red-100 cursor-pointer"><i class="fas fa-trash-alt text-sm"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
