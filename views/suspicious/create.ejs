<%- include('../layouts/header', { title: 'إضافة مشتبه به', pageTitle: 'السجلات الأساسية' }) %>

<div class="space-y-6 max-w-5xl mx-auto" dir="rtl">
    <div class="flex justify-between items-center">
        <h1 class="font-display font-bold text-2xl text-slate-900 dark:text-white">إضافة مشتبه به جديد</h1>
        <a href="/system/suspicious" class="px-4 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-sm font-bold">عودة</a>
    </div>

    <form action="/system/suspicious" method="POST" class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm space-y-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">الشخص المشتبه به <span class="text-red-500">*</span></label>
                <select name="personal_data_id" required class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm">
                    <option value="">-- اختر الشخص --</option>
                    <% for (const p of people) { %><option value="<%= p.id %>"><%= p.name %> (<%= p.military_number %>)</option><% } %>
                </select>
            </div>
            <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">رقم الاشتباه</label>
                <input type="text" name="suspect_number" value="S-<%= 7000 + Math.floor(Math.random() * 900) %>" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm font-mono">
            </div>
            <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">تاريخ الاشتباه</label>
                <input type="date" name="suspicion_date" value="<%= new Date().toISOString().slice(0, 10) %>" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm">
            </div>
            <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">مستوى الخطورة</label>
                <select name="status" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm">
                    <option value="حرج">حرج</option>
                    <option value="تحذير">تحذير</option>
                    <option value="عادي">عادي</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">نوع الاشتباه</label>
                <input type="text" name="suspicion_type" value="اشتباه أمني وعسكري" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm">
            </div>
            <div>
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">موقع الاشتباه</label>
                <input type="text" name="suspicion_location" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm">
            </div>
            <div class="md:col-span-2">
                <label class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">تفاصيل الاشتباه</label>
                <textarea name="suspicion_details" rows="3" class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl px-4 py-2.5 text-sm"></textarea>
            </div>
        </div>
        <div class="flex justify-end">
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm cursor-pointer"><i class="fas fa-save ml-1"></i> حفظ السجل</button>
        </div>
    </form>
</div>

<%- include('../layouts/footer') %>
