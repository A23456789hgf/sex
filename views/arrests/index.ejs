<%- include('../layouts/header', { title: 'سجل الموقوفين', pageTitle: 'السجلات الأساسية' }) %>

<div class="space-y-6" dir="rtl">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-3">
                <div class="p-2.5 bg-brand-500/10 text-brand-600 dark:text-brand-400 rounded-xl"><i class="fas fa-gavel text-xl"></i></div>
                سجل الموقوفين
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">إدارة ومتابعة قضايا وسجلات الموقوفين في النظام (إجمالي السجلات: <span class="font-bold text-slate-700 dark:text-slate-200"><%= arrests.length %></span>)</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <button type="button" onclick="window.print()" class="inline-flex items-center gap-2 px-4 py-2.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-semibold rounded-xl cursor-pointer"><i class="fas fa-print"></i> طباعة الكشف</button>
            <a href="/system/arrests/create" class="inline-flex items-center gap-2 px-4 py-2.5 bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold rounded-xl shadow-sm transition-all"><i class="fas fa-plus"></i> إضافة موقوف جديد</a>
        </div>
    </div>

    <% if (flashSuccess) { %>
        <div class="p-4 bg-emerald-500/10 border border-emerald-500/20 rounded-xl text-emerald-600 flex items-center justify-between">
            <div class="flex items-center gap-2"><i class="fas fa-check-circle"></i><span class="text-sm font-medium"><%= flashSuccess %></span></div>
            <button type="button" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
        </div>
    <% } %>

    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-4 shadow-sm">
        <form method="GET" action="/system/arrests" class="flex flex-col md:flex-row gap-3 items-center">
            <div class="flex-1 w-full relative">
                <i class="fas fa-search absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                <input type="text" name="search" value="<%= search || '' %>" placeholder="ابحث بالاسم، قضية، جهة..." class="w-full pr-10 pl-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-sm">
            </div>
            <button type="submit" class="px-6 py-2.5 bg-slate-900 dark:bg-slate-800 text-white rounded-xl text-sm font-semibold cursor-pointer">تصفية</button>
            <% if (search) { %><a href="/system/arrests" class="px-4 py-2.5 bg-slate-100 dark:bg-slate-800 rounded-xl text-xs font-semibold">إلغاء</a><% } %>
        </form>
    </div>

    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse">
                <thead>
                    <tr class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-bold text-xs uppercase tracking-wider">
                        <th class="px-6 py-4">#</th>
                        <th class="px-6 py-4">اسم الموقوف</th>
                        <th class="px-6 py-4">نوع القضية</th>
                        <th class="px-6 py-4 text-center">تاريخ التوقيف</th>
                        <th class="px-6 py-4">جهة التوقيف</th>
                        <th class="px-6 py-4 text-center">الحالة</th>
                        <th class="px-6 py-4 text-left">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
                    <% for (const arrest of arrests) { %>
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/25 transition-colors">
                            <td class="px-6 py-4 font-mono text-xs text-slate-400">#<%= String(arrest.id).padStart(4, '0') %></td>
                            <td class="px-6 py-4">
                                <% if (arrest.personalData) { %>
                                    <a href="/system/personal-data/<%= arrest.personalData.id %>" class="font-bold text-slate-900 dark:text-white hover:text-brand-600 block"><%= arrest.personalData.name %></a>
                                    <span class="text-xs text-slate-400 font-mono"><%= arrest.personalData.military_number %></span>
                                <% } else { %><span>-</span><% } %>
                            </td>
                            <td class="px-6 py-4"><span class="inline-flex items-center px-2.5 py-1 rounded-2xl text-xs font-semibold bg-purple-500/10 text-purple-600 border border-purple-500/20"><%= arrest.caseType?.name || '-' %></span></td>
                            <td class="px-6 py-4 text-center"><span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-2xl text-xs font-semibold bg-slate-100 dark:bg-slate-800"><%= arrest.arrest_date %></span></td>
                            <td class="px-6 py-4 text-slate-600 dark:text-slate-300 text-xs"><%= arrest.arrestingAuthority?.name || '-' %></td>
                            <td class="px-6 py-4 text-center"><%- include('../partials/security-badge', { level: arrest.status === 'مفرج عنه' ? 'resolved' : 'warning', label: arrest.status }) %></td>
                            <td class="px-6 py-4 text-left">
                                <div class="flex items-center justify-end gap-1.5">
                                    <a href="/system/arrests/<%= arrest.id %>" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-brand-600"><i class="fas fa-eye text-sm"></i></a>
                                    <form action="/system/arrests/<%= arrest.id %>?_method=DELETE" method="POST" class="inline m-0">
                                        <button type="submit" class="p-2 rounded-xl bg-red-50 text-red-600 cursor-pointer"><i class="fas fa-trash-alt text-sm"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
