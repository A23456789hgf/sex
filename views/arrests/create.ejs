<%- include('../layouts/header', { title: 'إضافة موقوف جديد', pageTitle: 'السجلات الأساسية' }) %>

<div class="max-w-5xl mx-auto space-y-6" dir="rtl">
    <div class="flex justify-between items-center">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">إضافة موقوف جديد</h1>
        <a href="/system/arrests" class="px-4 py-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-sm font-semibold">عودة للقائمة</a>
    </div>

    <form action="/system/arrests" method="POST" class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm space-y-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-2">الشخص الموقوف <span class="text-rose-500">*</span></label>
                <select name="personal_data_id" required class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-sm">
                    <option value="">-- اختر الاسم --</option>
                    <% for (const p of people) { %><option value="<%= p.id %>"><%= p.name %> (<%= p.military_number %>)</option><% } %>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-2">جهة التوقيف</label>
                <select name="arresting_authority_id" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-sm">
                    <% for (const a of authorities) { %><option value="<%= a.id %>"><%= a.name %></option><% } %>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-2">نوع القضية</label>
                <select name="case_type_id" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-sm">
                    <% for (const c of caseTypes) { %><option value="<%= c.id %>"><%= c.name %></option><% } %>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-2">تاريخ التوقيف</label>
                <input type="date" name="arrest_date" value="<%= new Date().toISOString().slice(0, 10) %>" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-sm">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-2">مكان التوقيف</label>
                <input type="text" name="arrest_location" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-sm">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-2">الحالة</label>
                <select name="status" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-sm">
                    <option value="قيد التحقيق">قيد التحقيق</option>
                    <option value="مفرج عنه">مفرج عنه</option>
                    <option value="محال للنيابة">محال للنيابة</option>
                </select>
            </div>
            <div class="md:col-span-2">
                <label class="block text-xs font-bold text-slate-600 dark:text-slate-300 mb-2">تفاصيل القضية</label>
                <textarea name="case_details" rows="3" class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl text-sm"></textarea>
            </div>
        </div>
        <div class="flex justify-end">
            <button type="submit" class="px-6 py-2.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-sm font-bold cursor-pointer"><i class="fas fa-save ml-1"></i> حفظ السجل</button>
        </div>
    </form>
</div>

<%- include('../layouts/footer') %>
