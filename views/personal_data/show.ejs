<%- include('../layouts/header', { title: 'تفاصيل السجل الشخصي', pageTitle: 'السجلات الأساسية' }) %>

<div class="space-y-6" dir="rtl">
    <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-2 print:hidden">
        <a href="/dashboard" class="hover:text-brand-600 transition-colors">الرئيسية</a>
        <span>/</span>
        <a href="/system/personal-data" class="hover:text-brand-600 transition-colors">إدارة البيانات الشخصية</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white font-semibold">تفاصيل السجل</span>
    </nav>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-4 print:hidden">
        <div>
            <h1 class="font-display font-bold text-2xl text-slate-900 dark:text-white m-0"><%= personalData.name %></h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">ملف رقم #<%= String(personalData.id).padStart(5, '0') %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2.5">
            <a href="/system/personal-data/<%= personalData.id %>/print" target="_blank" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl transition-all shadow-sm text-sm font-bold">
                <i class="fas fa-print"></i><span>طباعة البطاقة الأساسية</span>
            </a>
            <a href="/system/personal-data/<%= personalData.id %>/edit" class="inline-flex items-center gap-2 px-4 py-2.5 bg-amber-500 hover:bg-amber-600 text-white rounded-xl transition-all shadow-sm text-sm font-bold">
                <i class="fas fa-pen"></i><span>تعديل</span>
            </a>
            <a href="/system/personal-data" class="inline-flex items-center gap-2 px-4 py-2.5 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-xl hover:bg-slate-200 transition-colors text-sm font-bold">
                <i class="fas fa-arrow-right"></i><span>عودة للقائمة</span>
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-1">
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm p-6 lg:sticky lg:top-24">
                <div class="text-center mb-6">
                    <div class="w-32 h-32 rounded-2xl bg-slate-50 dark:bg-slate-800 border-2 border-dashed border-slate-200 dark:border-slate-700 mx-auto mb-4 overflow-hidden flex items-center justify-center shadow-inner">
                        <div class="text-slate-300 dark:text-slate-600 flex flex-col items-center justify-center">
                            <i class="fas fa-user text-4xl mb-1"></i>
                            <span class="text-[10px] font-bold">بدون صورة</span>
                        </div>
                    </div>
                    <h3 class="font-display font-bold text-xl text-slate-900 dark:text-white mb-2"><%= personalData.name %></h3>
                    <div class="flex items-center justify-center gap-2 mb-3">
                        <% if (personalData.jihadi_name) { %>
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-brand-50 dark:bg-brand-500/10 text-brand-700 dark:text-brand-300 border border-brand-200/50"><%= personalData.jihadi_name %></span>
                        <% } %>
                        <%- include('../partials/security-badge', { level: 'resolved', label: 'سجل نشط' }) %>
                    </div>
                </div>
                <hr class="border-slate-100 dark:border-slate-800 my-6" />
                <div class="space-y-4">
                    <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-100 dark:border-slate-800">
                        <span class="block text-xs font-bold text-slate-400 mb-1">الرقم القومي (الهوية)</span>
                        <div class="font-mono font-bold text-slate-800 dark:text-slate-200 flex items-center gap-2 text-sm"><i class="fas fa-id-card text-slate-400 text-xs"></i><%= personalData.national_id_number || 'غير مسجل' %></div>
                    </div>
                    <div class="p-3.5 rounded-xl bg-brand-50/50 dark:bg-brand-500/5 border border-brand-100 dark:border-brand-500/20">
                        <span class="block text-xs font-bold text-brand-600 dark:text-brand-400 mb-1">الرقم العسكري</span>
                        <div class="font-mono font-bold text-brand-700 dark:text-brand-300 flex items-center gap-2 text-sm"><i class="fas fa-shield-alt text-brand-500 text-xs"></i><%= personalData.military_number || 'غير مسجل' %></div>
                    </div>
                    <% if (personalData.phone_1) { %>
                        <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-100 dark:border-slate-800">
                            <span class="block text-xs font-bold text-slate-400 mb-1">أرقام الاتصال</span>
                            <div class="font-mono font-bold text-slate-800 dark:text-slate-200 text-xs flex items-center gap-2"><i class="fas fa-phone-alt text-slate-400"></i><%= personalData.phone_1 %></div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="lg:col-span-2 space-y-6">
            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
                <div class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 px-5 py-4 flex items-center gap-3">
                    <div class="w-2 h-5 bg-brand-600 rounded-full"></div>
                    <h2 class="font-display font-bold text-base text-slate-900 dark:text-white m-0">المعلومات المدنية والشخصية</h2>
                </div>
                <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div><span class="block text-xs font-bold text-slate-400 mb-1">فصيلة الدم</span><div class="text-sm font-bold text-slate-800 dark:text-slate-200"><%= personalData.bloodType?.type || '-' %></div></div>
                    <div><span class="block text-xs font-bold text-slate-400 mb-1">المؤهل الدراسي</span><div class="text-sm font-bold text-slate-800 dark:text-slate-200"><%= personalData.qualification?.name || '-' %></div></div>
                    <div><span class="block text-xs font-bold text-slate-400 mb-1">الحالة الاجتماعية</span><div class="text-sm font-bold text-slate-800 dark:text-slate-200"><%= personalData.maritalStatus?.name || '-' %></div></div>
                    <div><span class="block text-xs font-bold text-slate-400 mb-1">تاريخ الميلاد</span><div class="text-sm font-bold text-slate-800 dark:text-slate-200"><%= personalData.date_of_birth_gregorian || '-' %></div></div>
                    <div><span class="block text-xs font-bold text-slate-400 mb-1">عنوان السكن</span><div class="text-sm font-bold text-slate-800 dark:text-slate-200"><%= [personalData.governorate?.name, personalData.directorate?.name, personalData.subArea?.name, personalData.village?.name].filter(Boolean).join(' / ') || '-' %></div></div>
                    <div><span class="block text-xs font-bold text-slate-400 mb-1">تفاصيل إضافية للسكن</span><div class="text-sm font-bold text-slate-800 dark:text-slate-200"><%= personalData.current_address || '-' %></div></div>
                </div>
            </div>

            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden">
                <div class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 px-5 py-4 flex items-center gap-3">
                    <div class="w-2 h-5 bg-emerald-600 rounded-full"></div>
                    <h2 class="font-display font-bold text-base text-slate-900 dark:text-white m-0">السجل العسكري والمهني</h2>
                </div>
                <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div><span class="block text-xs font-bold text-slate-400 mb-1">الرتبة</span><div class="text-sm font-bold text-slate-800 dark:text-slate-200"><%= personalData.rank || '-' %></div></div>
                    <div><span class="block text-xs font-bold text-slate-400 mb-1">الجهة التابع لها</span><div class="text-sm font-bold text-slate-800 dark:text-slate-200"><%= personalData.internal_entity?.name || '-' %></div></div>
                    <div><span class="block text-xs font-bold text-slate-400 mb-1">الوحدة العسكرية</span><div class="text-sm font-bold text-slate-800 dark:text-slate-200"><%= personalData.unit || '-' %></div></div>
                    <div><span class="block text-xs font-bold text-slate-400 mb-1">التخصص الوظيفي</span><div class="text-sm font-bold text-slate-800 dark:text-slate-200"><%= personalData.job_specialty || '-' %></div></div>
                    <div class="md:col-span-2"><span class="block text-xs font-bold text-slate-400 mb-1">مقر العمل</span><div class="text-sm font-bold text-slate-800 dark:text-slate-200"><%= personalData.workplace || '-' %></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
