<%- include('../layouts/header', { title: 'إدارة البيانات الشخصية', pageTitle: 'السجلات الأساسية' }) %>

<div class="space-y-6" dir="rtl">
    <nav class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-400 mb-4 print:hidden" aria-label="Breadcrumb">
        <a href="/dashboard" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors font-medium">الرئيسية</a>
        <i class="fas fa-chevron-left text-[10px] text-slate-400"></i>
        <span class="text-slate-900 dark:text-white font-bold" aria-current="page">إدارة السجلات الأساسية</span>
    </nav>

    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm p-5 print:hidden">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-5">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-lg bg-brand-50 dark:bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center border border-brand-100 dark:border-brand-500/20 shrink-0">
                    <i class="fas fa-users text-xl"></i>
                </div>
                <div>
                    <h1 class="font-bold text-2xl text-slate-900 dark:text-white m-0 tracking-tight">البيانات الشخصية</h1>
                    <div class="flex items-center gap-4 mt-1.5 text-sm text-slate-600 dark:text-slate-400">
                        <span class="flex items-center gap-1.5">
                            <i class="fas fa-database text-slate-400"></i>
                            إجمالي الأشخاص: <strong class="text-slate-900 dark:text-slate-100"><%= total %></strong>
                        </span>
                        <span class="w-1 h-1 rounded-full bg-slate-300 dark:bg-slate-700"></span>
                        <span class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                            <i class="fas fa-arrow-trend-up"></i>
                            مُدخلات اليوم: <strong><%= todayCount %></strong>
                        </span>
                    </div>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                <button type="button" onclick="window.print()" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold transition-all text-xs sm:text-sm shadow-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 cursor-pointer">
                    <i class="fas fa-print text-xs"></i>
                    <span>طباعة الكشف</span>
                </button>
                <a href="/system/personal-data/create" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brand-600 text-white hover:bg-brand-700 text-sm font-bold shadow-sm transition-all">
                    <i class="fas fa-user-plus"></i> إضافة شخص جديد
                </a>
            </div>
        </div>
    </div>

    <% if (flashSuccess) { %>
        <div class="bg-emerald-50 dark:bg-emerald-500/10 border-l-4 border-emerald-500 text-emerald-800 dark:text-emerald-300 px-4 py-3 rounded-md shadow-sm flex items-center justify-between" role="alert">
            <div class="flex items-center gap-3">
                <i class="fas fa-check-circle text-emerald-500"></i>
                <span class="text-sm font-bold"><%= flashSuccess %></span>
            </div>
            <button type="button" class="text-emerald-500 hover:text-emerald-700 p-1" onclick="this.parentElement.remove()" aria-label="إغلاق">
                <i class="fas fa-times"></i>
            </button>
        </div>
    <% } %>

    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/20">
            <form method="GET" action="/system/personal-data" class="flex flex-col md:flex-row items-center gap-3">
                <div class="relative flex-1 w-full">
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400">
                        <i class="fas fa-search"></i>
                    </div>
                    <input type="text" name="search" class="w-full bg-white dark:bg-slate-950 border border-slate-300 dark:border-slate-700 rounded-md pr-10 pl-4 py-2 text-sm text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-brand-500 transition-all shadow-sm" placeholder="بحث برقم الهوية، الرقم العسكري، أو الاسم الرباعي..." value="<%= search || '' %>">
                </div>
                <div class="flex items-center gap-2 w-full md:w-auto">
                    <button type="submit" class="w-full md:w-auto px-6 py-2 rounded-md bg-slate-800 text-white hover:bg-slate-700 dark:bg-slate-700 dark:hover:bg-slate-600 text-sm font-bold shadow-sm transition-colors cursor-pointer">استعلام</button>
                    <% if (search) { %>
                        <a href="/system/personal-data" class="px-4 py-2 rounded-md border border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 text-sm font-semibold transition-colors bg-white dark:bg-slate-900">إلغاء</a>
                    <% } %>
                </div>
            </form>
        </div>

        <div class="overflow-x-auto min-h-[360px]">
            <table class="w-full text-sm text-right whitespace-nowrap">
                <thead class="bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300">
                    <tr>
                        <th scope="col" class="px-6 py-3.5 text-xs font-bold uppercase tracking-wider w-20 border-r border-slate-200 dark:border-slate-700"># المرجع</th>
                        <th scope="col" class="px-6 py-3.5 text-xs font-bold uppercase tracking-wider">بيانات السجل (الاسم الكامل)</th>
                        <th scope="col" class="px-6 py-3.5 text-xs font-bold uppercase tracking-wider">المعرفات الرسمية</th>
                        <th scope="col" class="px-6 py-3.5 text-xs font-bold uppercase tracking-wider">تاريخ الميلاد</th>
                        <th scope="col" class="px-6 py-3.5 text-xs font-bold uppercase tracking-wider">حالة القيد</th>
                        <th scope="col" class="px-6 py-3.5 text-xs font-bold uppercase tracking-wider text-left">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                    <% if (records.length === 0) { %>
                        <tr>
                            <td colspan="6" class="px-6 py-16 text-center bg-slate-50 dark:bg-slate-800/50">
                                <div class="flex flex-col items-center justify-center">
                                    <div class="w-16 h-16 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center mb-4 text-slate-400 shadow-sm"><i class="fas fa-folder-open text-2xl"></i></div>
                                    <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1">لا توجد قيود مسجلة</h3>
                                    <p class="text-sm text-slate-500 dark:text-slate-400 mb-5 max-w-sm">لم يتم العثور على أي سجلات تطابق معايير البحث الحالية.</p>
                                    <a href="/system/personal-data/create" class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-brand-600 text-white hover:bg-brand-700 font-bold text-sm shadow-sm transition-all"><i class="fas fa-plus"></i> إدراج قيد جديد</a>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                    <% for (const record of records) { %>
                        <tr class="hover:bg-brand-50/50 dark:hover:bg-brand-900/10 even:bg-slate-50 dark:even:bg-slate-800/30 transition-colors">
                            <td class="px-6 py-4 border-r border-slate-100 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-mono text-xs"><%= String(record.id).padStart(6, '0') %></td>
                            <td class="px-6 py-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 flex items-center justify-center font-bold text-xs shrink-0 border border-slate-300 dark:border-slate-600">
                                        <%= (record.name || '-').slice(0, 2) %>
                                    </div>
                                    <div>
                                        <a href="/system/personal-data/<%= record.id %>" class="font-bold text-slate-900 dark:text-white hover:text-brand-600 dark:hover:text-brand-400 hover:underline transition-all"><%= record.name %></a>
                                        <% if (record.jihadi_name) { %>
                                            <div class="text-[11px] text-slate-500 dark:text-slate-400 font-medium mt-0.5"><i class="fas fa-tag ml-1 text-slate-400"></i><%= record.jihadi_name %></div>
                                        <% } %>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="space-y-1.5">
                                    <% if (record.national_id_number) { %>
                                        <div class="flex items-center gap-2 text-xs text-slate-700 dark:text-slate-300 font-mono"><span class="w-5 text-center"><i class="fas fa-id-card text-slate-400"></i></span><span><%= record.national_id_number %></span></div>
                                    <% } %>
                                    <% if (record.military_number) { %>
                                        <div class="flex items-center gap-2 text-xs text-slate-700 dark:text-slate-300 font-mono"><span class="w-5 text-center"><i class="fas fa-shield-alt text-brand-500"></i></span><span class="font-bold"><%= record.military_number %></span></div>
                                    <% } %>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-sm font-medium text-slate-700 dark:text-slate-300">
                                <% if (record.date_of_birth_gregorian) { %>
                                    <div class="flex items-center gap-2"><i class="far fa-calendar-alt text-slate-400"></i><span dir="ltr"><%= record.date_of_birth_gregorian %></span></div>
                                <% } else { %><span class="text-slate-400">-</span><% } %>
                            </td>
                            <td class="px-6 py-4"><%- include('../partials/security-badge', { level: 'resolved', label: 'مكتمل' }) %></td>
                            <td class="px-6 py-4 text-left">
                                <div class="flex items-center justify-end gap-1.5">
                                    <a href="/system/personal-data/<%= record.id %>" class="p-2 rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400 hover:bg-blue-100 transition-all" title="استعراض الملف"><i class="fas fa-eye text-sm"></i></a>
                                    <a href="/system/personal-data/<%= record.id %>/edit" class="p-2 rounded-lg bg-amber-50 text-amber-600 dark:bg-amber-500/10 dark:text-amber-400 hover:bg-amber-100 transition-all" title="تعديل السجل"><i class="fas fa-pen text-sm"></i></a>
                                    <a href="/system/personal-data/<%= record.id %>/print" target="_blank" class="p-2 rounded-lg bg-indigo-50 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-400 hover:bg-indigo-100 transition-all" title="طباعة البطاقة"><i class="fas fa-print text-sm"></i></a>
                                    <form action="/system/personal-data/<%= record.id %>?_method=DELETE" method="POST" class="inline m-0 p-0">
                                        <button type="submit" class="p-2 rounded-lg bg-red-50 text-red-600 dark:bg-red-500/10 dark:text-red-400 hover:bg-red-100 transition-all cursor-pointer" title="حذف القيد"><i class="fas fa-trash-alt text-sm"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
