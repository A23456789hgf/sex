            </main>
        </div>
    </div>

    <div id="logoutModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden items-center justify-center p-4 transition-all duration-300" aria-modal="true" role="dialog">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl shadow-2xl p-6 text-center max-w-sm w-full relative transform transition-all">
            <div class="w-14 h-14 rounded-2xl bg-red-50 dark:bg-red-500/10 text-red-600 dark:text-red-400 flex items-center justify-center mx-auto mb-4 border border-red-100 dark:border-red-500/20 shadow-sm">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </div>
            <h5 class="font-display font-bold text-xl text-slate-900 dark:text-white mb-2">تسجيل الخروج</h5>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-6">هل أنت متأكد من رغبتك في إنهاء الجلسة وتسجيل الخروج؟</p>
            <div class="flex gap-3 justify-center">
                <button type="button" onclick="document.getElementById('logoutModal').classList.add('hidden'); document.getElementById('logoutModal').classList.remove('flex');" class="flex-1 px-4 py-2.5 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold text-sm rounded-xl transition-colors cursor-pointer">إلغاء</button>
                <form id="logout-form" action="/logout" method="POST" class="flex-1 m-0">
                    <button type="submit" class="w-full px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white font-bold text-sm rounded-xl transition-colors shadow-lg shadow-red-500/30 cursor-pointer">تأكيد الخروج</button>
                </form>
            </div>
        </div>
    </div>

    <div id="toastContainer" class="fixed bottom-5 left-5 z-50 flex flex-col gap-3 pointer-events-none max-w-sm w-full" aria-live="polite"></div>

    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/vendor/select2/select2.min.js"></script>

    <script>
    (function() {
        'use strict';
        const sidebar = document.getElementById('sidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        const toggleBtn = document.getElementById('sidebarToggleBtn');
        const closeBtn = document.getElementById('sidebarCloseBtn');
        const mainWrapper = document.getElementById('mainWrapper');
        let isCollapsedDesktop = false;

        function toggleSidebar() {
            if (window.innerWidth < 1024) {
                const isOpen = !sidebar.classList.contains('translate-x-full');
                if (isOpen) closeMobileSidebar(); else openMobileSidebar();
            } else {
                isCollapsedDesktop = !isCollapsedDesktop;
                if (isCollapsedDesktop) {
                    sidebar.classList.add('lg:w-20'); sidebar.classList.remove('lg:w-72');
                    mainWrapper.classList.add('lg:pr-20'); mainWrapper.classList.remove('lg:pr-72');
                } else {
                    sidebar.classList.remove('lg:w-20'); sidebar.classList.add('lg:w-72');
                    mainWrapper.classList.remove('lg:pr-20'); mainWrapper.classList.add('lg:pr-72');
                }
            }
        }
        function openMobileSidebar() {
            sidebar.classList.remove('translate-x-full');
            backdrop.classList.remove('hidden');
            requestAnimationFrame(() => backdrop.classList.remove('opacity-0'));
            document.body.style.overflow = 'hidden';
        }
        function closeMobileSidebar() {
            sidebar.classList.add('translate-x-full');
            backdrop.classList.add('opacity-0');
            setTimeout(() => { backdrop.classList.add('hidden'); document.body.style.overflow = ''; }, 300);
        }

        toggleBtn?.addEventListener('click', toggleSidebar);
        closeBtn?.addEventListener('click', closeMobileSidebar);
        backdrop?.addEventListener('click', closeMobileSidebar);

        document.addEventListener('click', (e) => {
            const userWrapper = document.getElementById('userMenuWrapper');
            const userMenuDropdown = document.getElementById('userMenuDropdown');
            if (userWrapper && userMenuDropdown && !userWrapper.contains(e.target)) {
                userMenuDropdown.classList.add('hidden');
            }
            if (!e.target.closest('.dropdown-menu') && !e.target.closest('.row-options-menu') && !e.target.closest('[onclick*="toggleRowDropdown"]')) {
                document.querySelectorAll('.dropdown-menu, .row-options-menu').forEach(m => {
                    if (!m.id.includes('userMenu')) { m.classList.add('hidden'); m.style.display = ''; }
                });
            }
        });

        window.toggleRowDropdown = function(btn, event) {
            if (event) { event.preventDefault(); event.stopPropagation(); }
            const container = btn.closest('.relative, .dropdown');
            const menu = container ? container.querySelector('.dropdown-menu, .row-options-menu') : null;
            if (!menu) return;
            const isHidden = menu.classList.contains('hidden') || getComputedStyle(menu).display === 'none';
            document.querySelectorAll('.dropdown-menu, .row-options-menu').forEach(m => {
                if (m !== menu && !m.id.includes('userMenu')) { m.classList.add('hidden'); m.style.display = ''; }
            });
            if (isHidden) { menu.classList.remove('hidden'); menu.style.display = 'block'; }
            else { menu.classList.add('hidden'); menu.style.display = 'none'; }
        };

        if (typeof jQuery !== 'undefined' && jQuery.fn.select2) {
            $(document).ready(function() {
                $('select').not('.no-select2').each(function() {
                    if (!$(this).hasClass('select2-hidden-accessible')) {
                        $(this).select2({ dir: 'rtl', width: '100%' });
                    }
                });
            });
        }
    })();
    </script>
</body>
</html>
