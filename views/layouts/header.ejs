<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title><%= typeof title !== 'undefined' ? title : 'لوحة التحكم' %> — <%= appName %></title>

    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();

        function toggleTheme() {
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            window.dispatchEvent(new CustomEvent('theme-changed', { detail: { isDark } }));
        }
        window.toggleTheme = toggleTheme;
        window.toggleDarkMode = toggleTheme;
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">

    <link rel="stylesheet" href="/vendor/select2/select2.min.css">
    <link rel="stylesheet" href="/vendor/fontawesome/all.min.css">
    <link rel="stylesheet" href="/css/app.css">

    <style>
        .select2-container { width: 100% !important; text-align: right; }
        .select2-container--default .select2-selection--single {
            background-color: #f8fafc !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 0.75rem !important;
            height: 42px !important;
            display: flex !important;
            align-items: center !important;
            padding: 0 0.5rem !important;
            transition: all 0.2s ease-in-out;
        }
        html.dark .select2-container--default .select2-selection--single {
            border-color: #334155 !important;
            background-color: #0f172a !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #0f172a !important;
            font-size: 0.875rem !important;
            font-weight: 500 !important;
            padding-right: 0.5rem !important;
            padding-left: 1.75rem !important;
            line-height: normal !important;
        }
        html.dark .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #f8fafc !important;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 100% !important;
            top: 0 !important;
            left: 8px !important;
            right: auto !important;
        }
        .select2-dropdown {
            background-color: #ffffff !important;
            border: 1px solid #cbd5e1 !important;
            border-radius: 0.75rem !important;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1) !important;
            overflow: hidden !important;
            z-index: 9999 !important;
        }
        html.dark .select2-dropdown {
            background-color: #0f172a !important;
            border-color: #334155 !important;
            color: #f8fafc !important;
        }
        @media print {
            aside#sidebar, #sidebarBackdrop, header, .print\:hidden, .no-print, button, .btn-action, .pagination-wrapper {
                display: none !important;
            }
            #mainWrapper { padding-right: 0 !important; margin: 0 !important; width: 100% !important; }
            body { background: #ffffff !important; color: #000000 !important; font-size: 11pt !important; }
        }
    </style>
</head>

<body class="min-h-screen bg-slate-50 dark:bg-slate-950 font-sans text-slate-900 dark:text-slate-50 antialiased transition-colors duration-300 selection:bg-brand-500/20 selection:text-brand-600">

    <div class="min-h-screen flex relative overflow-x-hidden">

        <div id="sidebarBackdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-40 lg:hidden hidden transition-opacity duration-300 opacity-0" aria-hidden="true"></div>

        <aside id="sidebar" class="fixed top-0 right-0 h-full bg-white dark:bg-slate-900 border-l border-slate-200 dark:border-slate-800 z-50 flex flex-col transition-all duration-300 ease-in-out print:hidden w-72 max-w-[85vw] translate-x-full lg:translate-x-0 shadow-2xl lg:shadow-none" aria-label="القائمة الجانبية">
            <div class="h-16 flex items-center justify-between px-4 lg:px-5 border-b border-slate-200 dark:border-slate-800 shrink-0">
                <a href="/dashboard" class="flex items-center gap-3 overflow-hidden group">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white flex items-center justify-center font-display font-bold shadow-lg shadow-brand-500/30 shrink-0 transition-transform group-hover:scale-105">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-display font-bold text-base text-slate-900 dark:text-white whitespace-nowrap leading-tight">
                            <%= appName %>
                        </span>
                        <span class="text-[10px] text-slate-400 dark:text-slate-500 font-medium">بالأمن الوقائي بالتعبئة العامة</span>
                    </div>
                </a>
                <button id="sidebarCloseBtn" class="lg:hidden p-2 text-slate-500 dark:text-slate-400 hover:text-red-500 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-colors" aria-label="إغلاق القائمة">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto overflow-x-hidden p-3 space-y-1 custom-scrollbar">
                <div class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest px-3 py-2 mt-1">الرئيسية</div>
                <% const isDashboard = currentPath === '/dashboard'; %>
                <a href="/dashboard" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition-all relative group <%= isDashboard ? 'bg-gradient-to-l from-brand-50 to-indigo-50/50 dark:from-brand-500/10 dark:to-indigo-500/5 text-brand-600 dark:text-brand-400' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' %>">
                    <% if (isDashboard) { %><span class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-5 bg-brand-600 dark:bg-brand-500 rounded-l-full"></span><% } %>
                    <div class="shrink-0 <%= isDashboard ? 'text-brand-600 dark:text-brand-400' : 'text-slate-400 dark:text-slate-500 group-hover:text-brand-600 dark:group-hover:text-brand-400' %>">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
                    </div>
                    <span class="whitespace-nowrap">لوحة التحكم</span>
                </a>

                <div class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest px-3 py-2 mt-4">إدارة الأفراد</div>
                <% const isPersonal = currentPath.startsWith('/system/personal-data'); %>
                <a href="/system/personal-data" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition-all relative group <%= isPersonal ? 'bg-gradient-to-l from-brand-50 to-indigo-50/50 dark:from-brand-500/10 dark:to-indigo-500/5 text-brand-600 dark:text-brand-400' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' %>">
                    <% if (isPersonal) { %><span class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-5 bg-brand-600 dark:bg-brand-500 rounded-l-full"></span><% } %>
                    <div class="shrink-0 <%= isPersonal ? 'text-brand-600 dark:text-brand-400' : 'text-slate-400 dark:text-slate-500 group-hover:text-brand-600 dark:group-hover:text-brand-400' %>">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <span class="whitespace-nowrap">البيانات الشخصية</span>
                </a>

                <div class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest px-3 py-2 mt-4">السجلات الأمنية</div>
                <% const isArrests = currentPath.startsWith('/system/arrests'); %>
                <a href="/system/arrests" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition-all relative group <%= isArrests ? 'bg-gradient-to-l from-brand-50 to-indigo-50/50 dark:from-brand-500/10 dark:to-indigo-500/5 text-brand-600 dark:text-brand-400' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' %>">
                    <% if (isArrests) { %><span class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-5 bg-brand-600 dark:bg-brand-500 rounded-l-full"></span><% } %>
                    <div class="shrink-0 <%= isArrests ? 'text-brand-600 dark:text-brand-400' : 'text-slate-400 dark:text-slate-500 group-hover:text-brand-600 dark:group-hover:text-brand-400' %>">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </div>
                    <span class="whitespace-nowrap">سجلات الضبط</span>
                </a>

                <% const isSuspicious = currentPath.startsWith('/system/suspicious'); %>
                <a href="/system/suspicious" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition-all relative group <%= isSuspicious ? 'bg-gradient-to-l from-brand-50 to-indigo-50/50 dark:from-brand-500/10 dark:to-indigo-500/5 text-brand-600 dark:text-brand-400' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' %>">
                    <% if (isSuspicious) { %><span class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-5 bg-brand-600 dark:bg-brand-500 rounded-l-full"></span><% } %>
                    <div class="shrink-0 <%= isSuspicious ? 'text-brand-600 dark:text-brand-400' : 'text-slate-400 dark:text-slate-500 group-hover:text-brand-600 dark:group-hover:text-brand-400' %>">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a5 5 0 0 0-5 5v2a5 5 0 0 0 10 0V7a5 5 0 0 0-5-5Z"/><path d="M4 19v-2a8 8 0 0 1 16 0v2"/><circle cx="12" cy="11" r="1"/></svg>
                    </div>
                    <span class="whitespace-nowrap">المشتبه بهم</span>
                </a>

                <% const isReports = currentPath.startsWith('/system/security-reports'); %>
                <a href="/system/security-reports" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition-all relative group <%= isReports ? 'bg-gradient-to-l from-brand-50 to-indigo-50/50 dark:from-brand-500/10 dark:to-indigo-500/5 text-brand-600 dark:text-brand-400' : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white' %>">
                    <% if (isReports) { %><span class="absolute right-0 top-1/2 -translate-y-1/2 w-1 h-5 bg-brand-600 dark:bg-brand-500 rounded-l-full"></span><% } %>
                    <div class="shrink-0 <%= isReports ? 'text-brand-600 dark:text-brand-400' : 'text-slate-400 dark:text-slate-500 group-hover:text-brand-600 dark:group-hover:text-brand-400' %>">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                    </div>
                    <span class="whitespace-nowrap">البلاغات الأمنية</span>
                </a>
                <div class="h-6"></div>
            </div>

            <div class="p-4 border-t border-slate-200 dark:border-slate-800 shrink-0">
                <button type="button" onclick="document.getElementById('logoutModal').classList.remove('hidden'); document.getElementById('logoutModal').classList.add('flex');" class="flex items-center gap-3 w-full p-2.5 text-slate-600 dark:text-slate-400 hover:text-red-600 dark:hover:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 rounded-xl transition-all font-semibold text-sm cursor-pointer">
                    <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    <span class="whitespace-nowrap">تسجيل الخروج</span>
                </button>
            </div>
        </aside>

        <div id="mainWrapper" class="flex-1 flex flex-col min-w-0 transition-all duration-300 ease-in-out print:pr-0 lg:pr-72">

            <header class="h-16 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 flex items-center justify-between px-4 lg:px-8 sticky top-0 z-30 transition-colors duration-300 print:hidden">
                <div class="flex items-center gap-4">
                    <button id="sidebarToggleBtn" class="p-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:text-brand-600 dark:hover:text-brand-400 hover:bg-brand-50 dark:hover:bg-brand-500/10 transition-all shadow-sm cursor-pointer" aria-label="تبديل القائمة الجانبية">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
                    </button>
                    <h1 class="font-display font-bold text-lg text-slate-900 dark:text-white hidden sm:block">
                        <%= typeof pageTitle !== 'undefined' ? pageTitle : (typeof title !== 'undefined' ? title : 'لوحة التحكم والتحليل') %>
                    </h1>
                </div>

                <div class="flex items-center gap-3">
                    <button type="button" onclick="window.print()" class="p-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-brand-50 dark:hover:bg-brand-500/10 text-slate-600 dark:text-slate-300 hover:text-brand-600 transition-colors shadow-sm cursor-pointer print:hidden" title="طباعة الصفحة الحالية">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                    </button>

                    <button id="themeToggleBtn" onclick="toggleTheme()" class="p-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-600 dark:text-slate-300 transition-colors shadow-sm cursor-pointer" title="تبديل الوضع الليلي / النهاري">
                        <svg class="w-5 h-5 hidden dark:block text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                        <svg class="w-5 h-5 block dark:hidden text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
                    </button>

                    <% const userName = currentUser?.name || 'المسؤول العام'; %>
                    <% const userRole = currentUser?.role || 'super-admin'; %>
                    <% const userEmail = currentUser?.email || 'admin@system.com'; %>
                    <% const userInitial = userName.slice(0, 1); %>
                    <div class="relative" id="userMenuWrapper">
                        <button id="userMenuBtn" type="button" onclick="document.getElementById('userMenuDropdown').classList.toggle('hidden')" class="flex items-center gap-3 p-1.5 pr-1.5 pl-4 rounded-full border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 cursor-pointer hover:shadow-sm transition-all">
                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white text-sm font-bold shrink-0 shadow-sm shadow-brand-500/30"><%= userInitial %></div>
                            <div class="hidden sm:block text-right leading-tight">
                                <div class="text-sm font-bold text-slate-900 dark:text-white"><%= userName %></div>
                                <div class="text-[10px] text-slate-500 dark:text-slate-400"><%= userRole %></div>
                            </div>
                            <svg class="w-4 h-4 text-slate-400 hidden sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                        <div id="userMenuDropdown" class="hidden absolute left-0 top-full mt-2 p-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-xl min-w-[220px] z-50">
                            <div class="px-3 py-2 border-b border-slate-100 dark:border-slate-800 mb-1">
                                <div class="font-bold text-sm text-slate-900 dark:text-white"><%= userName %></div>
                                <div class="text-xs text-slate-400 dark:text-slate-500"><%= userEmail %></div>
                            </div>
                            <button type="button" onclick="document.getElementById('userMenuDropdown').classList.add('hidden'); document.getElementById('logoutModal').classList.remove('hidden'); document.getElementById('logoutModal').classList.add('flex');" class="w-full flex items-center gap-2.5 px-3 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-500/10 rounded-xl transition-colors font-medium cursor-pointer">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                <span>تسجيل الخروج</span>
                            </button>
                        </div>
                    </div>
                </div>
            </header>

            <main class="flex-1 p-4 lg:p-8 overflow-x-hidden">
