<%- include('layouts/header', { title: 'لوحة التحكم والتحليل', pageTitle: 'لوحة التحكم والتحليل' }) %>

<div class="space-y-6" dir="rtl">
    <nav class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-6 print:hidden">
        <a href="/dashboard" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">الرئيسية</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white font-semibold">لوحة التحكم</span>
    </nav>

    <div class="bg-white dark:bg-slate-900 p-3 sm:p-4 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col md:flex-row gap-3 items-center transition-colors relative">
        <form action="/system/personal-data" method="GET" class="relative flex-1 w-full">
            <svg class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 w-5 h-5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" name="search" placeholder="بحث شامل في البيانات الشخصية، البلاغات الأمنية، والمشتبه بهم..."
                class="w-full bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-xl py-2.5 pr-11 pl-4 focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all text-sm font-medium placeholder:text-slate-400 dark:placeholder:text-slate-500 text-slate-900 dark:text-white" autocomplete="off">
        </form>
        <div class="flex gap-2 w-full md:w-auto">
            <a href="/system/personal-data/create" class="bg-brand-600 hover:bg-brand-700 text-white px-6 py-2.5 rounded-xl font-bold transition-all text-sm shadow-sm shadow-brand-500/30 shrink-0 inline-flex items-center gap-2">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                <span>إضافة فرد جديد</span>
            </a>
        </div>
    </div>

    <div class="flex items-center gap-4 p-4 rounded-2xl bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 shadow-sm transition-colors">
        <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center shrink-0 shadow-lg shadow-amber-500/30">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <div class="flex-1">
            <h6 class="font-display font-bold text-amber-700 dark:text-amber-400 mb-0.5">تنبيه المتابعة اليومية</h6>
            <p class="text-sm text-slate-600 dark:text-amber-200/70 m-0">تم تسجيل <span class="font-bold text-amber-800 dark:text-amber-300"><%= stats.total_today %></span> سجلات جديدة اليوم ضمن نطاق صلاحياتك الإدارية والجغرافية.</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <a href="/system/personal-data" class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between transition-all hover:border-brand-500/40 group">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <p class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">البيانات الشخصية</p>
                    <h3 class="font-display font-bold text-3xl text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors"><%= stats.personal_data_count %></h3>
                </div>
                <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
            </div>
            <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-2 border-t border-slate-100 dark:border-slate-800 font-medium">
                <span>سجلات الأفراد المسجلة</span>
                <i class="fas fa-arrow-left text-[10px] group-hover:-translate-x-1 transition-transform"></i>
            </div>
        </a>

        <a href="/system/security-reports" class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between transition-all hover:border-blue-500/40 group">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <p class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">البلاغات الأمنية</p>
                    <h3 class="font-display font-bold text-3xl text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"><%= stats.reports_count %></h3>
                </div>
                <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                </div>
            </div>
            <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-2 border-t border-slate-100 dark:border-slate-800 font-medium">
                <span>إجمالي البلاغات المسجلة</span>
                <i class="fas fa-arrow-left text-[10px] group-hover:-translate-x-1 transition-transform"></i>
            </div>
        </a>

        <a href="/system/arrests" class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between transition-all hover:border-emerald-500/40 group">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <p class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">سجلات الضبط والتوقيف</p>
                    <h3 class="font-display font-bold text-3xl text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors"><%= stats.arrests_count %></h3>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
            </div>
            <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-2 border-t border-slate-100 dark:border-slate-800 font-medium">
                <span>قيود التوقيف الموثقة</span>
                <i class="fas fa-arrow-left text-[10px] group-hover:-translate-x-1 transition-transform"></i>
            </div>
        </a>

        <a href="/system/suspicious" class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between transition-all hover:border-rose-500/40 group">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <p class="text-[11px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1">المشتبه بهم</p>
                    <h3 class="font-display font-bold text-3xl text-slate-900 dark:text-white group-hover:text-rose-600 dark:group-hover:text-rose-400 transition-colors"><%= stats.suspicious_count %></h3>
                </div>
                <div class="w-10 h-10 rounded-xl bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a5 5 0 0 0-5 5v2a5 5 0 0 0 10 0V7a5 5 0 0 0-5-5Z"/><path d="M4 19v-2a8 8 0 0 1 16 0v2"/><circle cx="12" cy="11" r="1"/></svg>
                </div>
            </div>
            <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-2 border-t border-slate-100 dark:border-slate-800 font-medium">
                <span class="text-rose-600 dark:text-rose-400 font-bold"><%= stats.critical_suspects %> حالات حرجة</span>
                <i class="fas fa-arrow-left text-[10px] group-hover:-translate-x-1 transition-transform"></i>
            </div>
        </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <div><span class="text-slate-400 text-xs font-semibold block">الدورات التدريبية</span><span class="text-lg font-bold text-slate-900 dark:text-white"><%= stats.courses_count %></span></div>
            <i class="fas fa-graduation-cap text-emerald-500 text-xl"></i>
        </div>
        <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <div><span class="text-slate-400 text-xs font-semibold block">الملفات الأمنية</span><span class="text-lg font-bold text-slate-900 dark:text-white"><%= stats.security_files_count %></span></div>
            <i class="fas fa-shield-alt text-rose-500 text-xl"></i>
        </div>
        <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <div><span class="text-slate-400 text-xs font-semibold block">بيانات الزوجات</span><span class="text-lg font-bold text-slate-900 dark:text-white"><%= stats.wives_count %></span></div>
            <i class="fas fa-heart text-pink-500 text-xl"></i>
        </div>
        <div class="bg-white dark:bg-slate-900 p-4 rounded-xl border border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <div><span class="text-slate-400 text-xs font-semibold block">الأهل والأقارب</span><span class="text-lg font-bold text-slate-900 dark:text-white"><%= stats.relatives_count %></span></div>
            <i class="fas fa-users text-indigo-500 text-xl"></i>
        </div>
    </div>

    <div class="space-y-6 mt-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm transition-colors">
                <h6 class="font-display font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
                    <span class="w-2 h-4 bg-brand-600 rounded-full"></span>
                    معدل البلاغات الأمنية الحقيقي (آخر 7 أيام)
                </h6>
                <div class="h-72 relative"><canvas id="reportsChart"></canvas></div>
            </div>

            <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm transition-colors">
                <h6 class="font-display font-bold text-slate-900 dark:text-white mb-6 flex items-center gap-2">
                    <span class="w-2 h-4 bg-amber-500 rounded-full"></span>
                    تصنيف المشتبه بهم الحقيقي (حسب الخطورة)
                </h6>
                <div class="h-72 relative flex items-center justify-center"><canvas id="suspectsPieChart"></canvas></div>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-900 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm transition-colors">
            <div class="mb-6">
                <h6 class="font-display font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <span class="w-2 h-4 bg-emerald-600 rounded-full"></span>
                    حالات الضبط والتوقيف الموثقة (آخر 7 أيام)
                </h6>
                <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mt-1">مؤشر يوضح تتبع حالات وتواريخ الضبط المقيدة بالنظام.</p>
            </div>
            <div class="h-72 relative"><canvas id="activeCasesChart"></canvas></div>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <h3 class="font-bold text-slate-900 dark:text-white text-base flex items-center gap-2">
                <span class="w-2 h-5 bg-brand-600 rounded-full"></span>
                أحدث السجلات الشخصية المضافة حديثاً
            </h3>
            <a href="/system/personal-data" class="text-xs font-bold text-brand-600 hover:text-brand-700 dark:text-brand-400">
                عرض الكشف الكامل <i class="fas fa-arrow-left mr-1"></i>
            </a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-right border-collapse">
                <thead>
                    <tr class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 font-bold text-xs uppercase tracking-wider">
                        <th class="px-6 py-4">الاسم الكامل</th>
                        <th class="px-6 py-4">الاسم الجهادي</th>
                        <th class="px-6 py-4">الرقم العسكري</th>
                        <th class="px-6 py-4">الجهة التابع لها</th>
                        <th class="px-6 py-4 text-center">تاريخ التسجيل</th>
                        <th class="px-6 py-4 text-left">الملف</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
                    <% for (const entry of recent_entries) { %>
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/25 transition-colors">
                            <td class="px-6 py-4 font-bold text-slate-900 dark:text-white">
                                <a href="/system/personal-data/<%= entry.id %>" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors"><%= entry.name %></a>
                            </td>
                            <td class="px-6 py-4 text-slate-600 dark:text-slate-300"><%= entry.jihadi_name || '-' %></td>
                            <td class="px-6 py-4 font-mono font-semibold text-xs text-slate-700 dark:text-slate-300"><%= entry.military_number || '-' %></td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-xl text-xs font-semibold bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">
                                    <%= entry.internal_entity ? entry.internal_entity.name : 'عام' %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center text-xs text-slate-500"><%= entry.created_at %></td>
                            <td class="px-6 py-4 text-left">
                                <a href="/system/personal-data/<%= entry.id %>" class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:text-brand-600 transition-colors">
                                    <i class="fas fa-eye text-xs"></i>
                                </a>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const chartData = <%- JSON.stringify(chart_data) %>;
    const isDark = document.documentElement.classList.contains('dark');
    const textColor = isDark ? '#94a3b8' : '#64748b';
    const gridColor = isDark ? 'rgba(148, 163, 184, 0.1)' : 'rgba(148, 163, 184, 0.15)';
    if (window.Chart) {
        Chart.defaults.font.family = 'Cairo, sans-serif';
        Chart.defaults.color = textColor;
        const reportsCtx = document.getElementById('reportsChart')?.getContext('2d');
        if (reportsCtx) {
            new Chart(reportsCtx, {
                type: 'bar',
                data: { labels: chartData.labels, datasets: [{ label: 'عدد البلاغات الأمنية', data: chartData.reports_daily, backgroundColor: '#4f46e5', borderRadius: 6, barThickness: 28 }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { grid: { color: gridColor }, beginAtZero: true, ticks: { precision: 0 } } } }
            });
        }
        const suspectsCtx = document.getElementById('suspectsPieChart')?.getContext('2d');
        if (suspectsCtx) {
            const b = chartData.suspects_breakdown;
            new Chart(suspectsCtx, {
                type: 'doughnut',
                data: { labels: ['حرج', 'تحذير', 'عادي/أخرى'], datasets: [{ data: [b.critical, b.warning, b.normal], backgroundColor: ['#ef4444', '#f59e0b', '#10b981'], borderWidth: 0, hoverOffset: 6 }] },
                options: { responsive: true, maintainAspectRatio: false, cutout: '70%', plugins: { legend: { position: 'bottom' } } }
            });
        }
        const activeCasesCtx = document.getElementById('activeCasesChart')?.getContext('2d');
        if (activeCasesCtx) {
            new Chart(activeCasesCtx, {
                type: 'bar',
                data: { labels: chartData.labels, datasets: [{ label: 'سجلات الضبط والتوقيف', data: chartData.arrests_daily, backgroundColor: '#059669', borderRadius: 6, barThickness: 32 }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { grid: { color: gridColor }, beginAtZero: true, ticks: { precision: 0 } } } }
            });
        }
    }
});
</script>

<%- include('layouts/footer') %>
